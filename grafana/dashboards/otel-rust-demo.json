{
  "title": "otel-rust-demo",
  "uid": "otel-rust-demo",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_requests_total, otel_scope_name)",
          "refId": "A"
        },
        "includeAll": true,
        "allValue": ".*",
        "sort": 1,
        "refresh": 2,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate by path",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open in Jaeger",
              "url": "http://localhost:16686/search?service=${__field.labels.otel_scope_name}&operation=${__field.labels.path}&lookback=15m",
              "targetBlank": true
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{otel_scope_name=~\"$service\"}[1m])) by (path, otel_scope_name)",
          "legendFormat": "{{otel_scope_name}} {{path}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Error rate (5xx) by path",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open in Jaeger",
              "url": "http://localhost:16686/search?service=${__field.labels.otel_scope_name}&operation=${__field.labels.path}&lookback=15m",
              "targetBlank": true
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{otel_scope_name=~\"$service\",status=~\"5..\"}[1m])) by (path, otel_scope_name)",
          "legendFormat": "{{otel_scope_name}} {{path}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "p95 latency by path",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open in Jaeger",
              "url": "http://localhost:16686/search?service=${__field.labels.otel_scope_name}&operation=${__field.labels.path}&lookback=15m",
              "targetBlank": true
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{otel_scope_name=~\"$service\"}[5m])) by (le, path, otel_scope_name))",
          "legendFormat": "{{otel_scope_name}} {{path}}",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "In-flight requests",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "links": [
            {
              "title": "Open in Jaeger",
              "url": "http://localhost:16686/search?service=${__field.labels.otel_scope_name}&lookback=15m",
              "targetBlank": true
            }
          ]
        }
      },
      "targets": [
        {
          "expr": "http_requests_in_flight{otel_scope_name=~\"$service\"}",
          "legendFormat": "{{otel_scope_name}} in-flight",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ]
    }
  ]
}